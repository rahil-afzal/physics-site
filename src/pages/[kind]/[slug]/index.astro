---
import { render } from 'astro:content';
import Base from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Status from '../../../components/Status.astro';
import ResourceLinks from '../../../components/ResourceLinks.astro';
import { getTree, url } from '../../../lib/content';
import { mdxComponents } from '../../../lib/mdx';

export async function getStaticPaths() {
  return (await getTree()).map((root) => ({ params: { kind: root.kind, slug: root.slug }, props: { root } }));
}
const { root } = Astro.props;
const d = root.entry.data;
const { Content } = await render(root.entry);
const taught = new Set(d.teaching_scope ?? []);
const rest = (d.official_scope ?? []).filter((s) => !taught.has(s));
---
<Base title={d.title} description={d.description}>
  <div class="narrow">
    <Breadcrumbs items={[{ label: d.course_code ?? d.title }]} />
    <h1>{d.course_code ? `${d.course_code} — ` : ''}{d.title}<Status status={d.status} /></h1>
    <p class="meta">{[d.audience, d.term, d.instructor].filter(Boolean).join(' · ')}</p>
    {d.description && <p>{d.description}</p>}
    <div class="prose"><Content components={mdxComponents} /></div>
    <ResourceLinks links={d.links} />
    {(d.teaching_scope || d.official_scope) && (
      <section>
        <h2>Scope</h2>
        {d.teaching_scope && <><h3>Current teaching scope</h3><ul>{d.teaching_scope.map((s) => <li>{s}</li>)}</ul></>}
        {rest.length > 0 && (
          <>
            <h3>{d.teaching_scope ? 'In the official syllabus, outside the current teaching scope' : 'Official syllabus'}</h3>
            <ul class="muted-list">{rest.map((s) => <li>{s}</li>)}</ul>
          </>
        )}
      </section>
    )}
    <section>
      <h2>Contents</h2>
      {root.topics.length === 0 ? <p class="muted">No topics yet.</p> : (
        <ol class="contents">
          {root.topics.map((t) => (
            <li>
              <a href={url(t.href)}>{t.title}</a><Status status={t.entry?.data.status} />
              {t.lectures.length > 0 && (
                <ol>{t.lectures.map((l) => <li><a href={url(l.href)}>{l.title}</a><Status status={l.entry.data.status} /></li>)}</ol>
              )}
            </li>
          ))}
        </ol>
      )}
    </section>
  </div>
</Base>
